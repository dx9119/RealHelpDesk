# Шаблон локальных секретов. Рабочий файл infrastructure/.env в git не попадает:
#   cp infrastructure/.env.example infrastructure/.env
# Секрет подписи и проверки JWT (HS256, base64, минимум 32 байта).
# Сгенерировать: openssl rand -base64 32
JWT_SECRET=

# Пароль PostgreSQL (общий для приложения, основной БД и шардов).
DB_PASSWORD=

# Необязательные переопределения инфраструктуры compose (дефолты — user/desk):
#POSTGRES_USER=user
#POSTGRES_DB=desk

# Пароль от SMTP. Локальному smtp4dev аутентификация не нужна (пусто);
# рабочему SMTP — пароль учетной записи MAIL_USER (см. scripts/docker/stack.prod.env).
MAIL_PASSWORD=

# Пароль keystore. Keystore генерируется при старте контейнера,
# поэтому смена пароля не требует пересборки: поправить infrastructure/.env и
#   make restart
KEY_STORE_PASS=demo-keystore-pass

# Учётные данные root-пользователя MinIO (файлы вложений заявок): их же
# приложение получает как MINIO_ACCESS_KEY/MINIO_SECRET_KEY. Пустое значение
# обязательной переменной валит compose на старте.
# Сгенерировать: openssl rand -base64 32
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=

# Пароль сервисной учётки HTTP Basic для /actuator/prometheus на управляющем
# порту (8081). Имя пользователя — METRICS_USER из scripts/docker/stack.env.
# Пустое значение валит compose на старте — скрейп без пароля закрыт.
# Сгенерировать: openssl rand -base64 32
METRICS_PASSWORD=

# Учётные данные администратора Grafana (make obs-up).
# Пароль по умолчанию admin — задайте свой; пользователь admin.
# Сгенерировать: openssl rand -base64 32
#GRAFANA_ADMIN_USER=admin
#GRAFANA_ADMIN_PASSWORD=
# Порт Grafana на хосту (дефолт 3001: 3000 обычно занят dev-сервером фронтенда).
#GRAFANA_PORT=3001

# Порт API MinIO на хосту (по умолчанию 9000); UI контейнера — 127.0.0.1:9001.
# Приложению порт не нужен: оно ходит во внутреннюю сеть http://minio:9000.
#MINIO_API_PORT=9000

# Пользователи ShardingSphere-Proxy (шардирование, порт 127.0.0.1:3307):
# root — администрирование, sharding — обычные подключения приложений.
# Шаблон конфигурации: infrastructure/shardingsphere/conf/global.yaml.
# Заполняются перед make up-sharding: compose-файл шардирования валит запуск
# с пустыми значениями (обязательные переменные ${VAR:?}). Сгенерировать: openssl rand -base64 32
SHARDINGSPHERE_ROOT_PASSWORD=
SHARDINGSPHERE_SHARDING_PASSWORD=

# Куда подключается приложение. По умолчанию — основная БД (дефолт в
# scripts/docker/stack.env, включая reWriteBatchedInserts=true); для работы
# через ShardingSphere-Proxy (make up-sharding):
#DB_URL=jdbc:postgresql://shardingsphere:3307/desk
