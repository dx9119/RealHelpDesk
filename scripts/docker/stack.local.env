# Локальная разработка: переопределяет stack.env.
# Подключается compose override-файлом (docker-compose.override.yaml) ПОСЛЕ базового
# stack.env, поэтому здесь только отличия от рабочих дефолтов, без повторов.
#
# Применение: make up / любой compose без явного -f (docker сам берёт override).

# Подробные логи и SQL вместо тихого prod
SPRING_PROFILES_ACTIVE=debug

# Капча мешает отладке форм — локально выключаем (в prod включена обязательна)
CAPTCHA_ENABLED=false

# Отладка в браузере на http://localhost:3000: cross-site cookie требует None+SameSite.
# Prod-preflight требует None только вместе с JWT_COOKIE_DOMAIN, здесь домена нет —
# локально preflight не выполняется (профиль не prod).
JWT_COOKIE_SAMESITE=None

# Origin'ы фронтенда локальной разработки
CORS_ALLOWED_ORIGINS=https://localhost.ru,https://example.com

# Локальный smtp4dev (UI на localhost:3000, порт проброшен на хост 127.0.0.1)
MAIL_HOST=smtp
MAIL_PORT=25
SMTP_AUTH=false
SMTP_STARTTLS=false
