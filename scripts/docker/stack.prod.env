# Рабочий контур: переопределяет stack.env под конкретный деплой.
# Подключается prod-файлом compose (docker-compose.prod.yaml) ПОСЛЕ базового.
#
# Применение: make up-prod. Файл — шаблон: заполните реальными значениями
# и держите в infrastructure/.env (секреты) либо в этом файле (несекретные
# переопределения). Секреты сюда не пишем.

SPRING_PROFILES_ACTIVE=prod
CAPTCHA_ENABLED=true
JWT_COOKIE_SAMESITE=Lax

# Общий домен cookie для поддоменов, например при раздельном домене файлов
# (STATIC_BASE_URL); пусто — host-only cookie
#JWT_COOKIE_DOMAIN=.example.com

# Origin'ы продового фронта, через запятую; localhost недопустим (preflight)
CORS_ALLOWED_ORIGINS=https://app.example.com
JWT_ISSUER=https://app.example.com
JWT_AUDIENCE=https://app.example.com

# SMTP рабочего контура: внешний почтовый сервер, локального smtp здесь нет.
# Prod-preflight отвергнет старт с MAIL_HOST=localhost/127.0.0.1/«smtp», с пустым
# MAIL_FROM и с SMTP_AUTH=true без MAIL_USER; пароль MAIL_PASSWORD — в infrastructure/.env.
MAIL_HOST=smtp.example.com
MAIL_PORT=587
SMTP_AUTH=true
SMTP_STARTTLS=true

# За reverse-proxy (nginx/traefik на этом же хосте): читать X-Forwarded-For
# и класть его в логи и рейт-лимит
TRUST_PROXY_HEADERS=true
CLIENT_IP_FORWARDED_INDEX=-1

# Keystore с реальным сертификатом смонтирован в контейнер по KEY_STORE_PATH
# (file:/app/ssl/keystore.p12 из stack.env). Prod-preflight остановит старт,
# если сертификат самоподписанный с CN=localhost.
