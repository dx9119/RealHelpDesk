# Единый env-файл стека: продукт, окружение приложения и инфраструктура.
# Все сервисы infrastructure/docker-compose.yaml получают его через env_file — значения ниже
# и есть конфигурация по умолчанию; менять их можно здесь, без правки compose.
#
# Схема обязательных ключей приложения — src/main/resources/application.properties
# (только ${VAR} без дефолтов); парность с этим файлом сверяет
# ApplicationConfigSchemaTest.
#
# Секретов здесь быть не должно: они лежат в infrastructure/.env (см. infrastructure/.env.example) и
# подставляются в infrastructure/docker-compose.yaml через ${VAR:?} — отсутствующий или пустой
# секрет валит compose на старте.
#
# Интерполяция: ${VAR} и ${VAR:-default} внутри значений читаются из окружения
# compose (infrastructure/.env и переменные хоста) — так работает DB_URL ниже. Правило про $:
# значение читается до попадания в контейнер, поэтому pa$sword станет pa —
# экранируйте как p$$ss. Строки в кавычки брать не нужно, но # внутри значения
# не работает: всё после # считается комментарием.

# ===========================================================================
# Продукт: лимиты, капча, сроки токенов, название и адреса писем.
# ===========================================================================

# --- Rate limit: пороги (число запросов / окно в секундах) ---
# Ключ должен совпадать с key в аннотации @RateLimit на методе контроллера.
# Берёт ли приложение IP клиента из X-Forwarded-For — см. TRUST_PROXY_HEADERS
# ниже (включать только за прокси).
RATE_LIMIT_AUTH_REGISTER_REQUESTS=10
RATE_LIMIT_AUTH_REGISTER_WINDOW_SECONDS=300
RATE_LIMIT_AUTH_LOGIN_REQUESTS=10
RATE_LIMIT_AUTH_LOGIN_WINDOW_SECONDS=300
RATE_LIMIT_AUTH_ACCESS_TOKEN_REQUESTS=30
RATE_LIMIT_AUTH_ACCESS_TOKEN_WINDOW_SECONDS=300
RATE_LIMIT_CAPTCHA_REQUESTS=30
RATE_LIMIT_CAPTCHA_WINDOW_SECONDS=60
RATE_LIMIT_PASSWORD_RESET_REQUEST_REQUESTS=3
RATE_LIMIT_PASSWORD_RESET_REQUEST_WINDOW_SECONDS=600
RATE_LIMIT_PASSWORD_RESET_CONFIRM_REQUESTS=5
RATE_LIMIT_PASSWORD_RESET_CONFIRM_WINDOW_SECONDS=600
RATE_LIMIT_EMAIL_CODE_REQUESTS=3
RATE_LIMIT_EMAIL_CODE_WINDOW_SECONDS=600
# Лимит писем восстановления пароля на один адрес (окно 86400 сек = 24 часа)
RATE_LIMIT_EMAIL_RECOVERY_REQUESTS=3
RATE_LIMIT_EMAIL_RECOVERY_WINDOW_SECONDS=86400
# Long polling оповещений: 30 подключений в минуту на IP — вкладка держит
# один запрос ~25 сек (около 2.4 в минуту), запас на переподключения
RATE_LIMIT_NOTIFICATIONS_WAIT_REQUESTS=30
RATE_LIMIT_NOTIFICATIONS_WAIT_WINDOW_SECONDS=60
# Передача портала: initiate (инициатор) и confirm (новый владелец) — с паролем
RATE_LIMIT_PORTAL_TRANSFER_REQUEST_REQUESTS=5
RATE_LIMIT_PORTAL_TRANSFER_REQUEST_WINDOW_SECONDS=300
RATE_LIMIT_PORTAL_TRANSFER_CONFIRM_REQUESTS=5
RATE_LIMIT_PORTAL_TRANSFER_CONFIRM_WINDOW_SECONDS=300

# --- Капча ---
CAPTCHA_ENABLED=false

# --- JWT: сроки жизни и cookie ---
# Ключи секции: два срока жизни в минутах, SameSite и домен для auth-cookie.
# Секрет, issuer/audience — см. секции «JWT: домены» и infrastructure/docker-compose.yaml
# (JWT_SECRET — в infrastructure/.env).
JWT_ACCESS_TOKEN_EXPIRATION=60
JWT_REFRESH_TOKEN_EXPIRATION=43200
# SameSite: весь допустимый набор — None, Lax, Strict (enum SameSite в коде);
# регистр не важен, любое другое значение останавливает старт приложения.
JWT_COOKIE_SAMESITE=None
# Домен cookie: пусто — cookie только для своего хоста (host-only); .example.com —
# общий для поддоменов, нужен, когда файлы отдаёт отдельный домен (STATIC_BASE_URL).
JWT_COOKIE_DOMAIN=

# --- Название и почтовые адреса ---
# MAIL_FROM и MAIL_NOTIFY — домены из application-domains.properties.
APP_NAME=Real help desk
APP_PROJECT_NAME=real help desk
MAIL_FROM=noreply@example.com
MAIL_NOTIFY=admin@example.com

# --- JPA: архитектурное решение, не зависит от окружения ---
JPA_OSIV=false

# --- MinIO: файлы вложений заявок ---
# Имя бакета; создаётся автоматически при первом обращении приложения.
# Адрес MinIO и его учётки (MINIO_ENDPOINT/MINIO_ACCESS_KEY/MINIO_SECRET_KEY) —
# в секции «MinIO» ниже и infrastructure/docker-compose.yaml, секреты — в infrastructure/.env.
MINIO_BUCKET=realhelpdesk-attachments

# --- Статический контент: отдельный origin для файлов ---
# Публичный адрес раздачи файлов (домен или ip:port) — из него API собирает
# downloadUrl в ответах; пусто — ссылки относительные, файлы отдаёт сам API.
# Перед этим адресом встаёт reverse-proxy/CDN, приложение остаётся origin'ом.
STATIC_BASE_URL=
# Cache-Control для отдачи файлов: значение уходит в заголовок как есть.
# private, no-store — не кэшировать (дефолт); public, max-age=... — можно за CDN,
# только если доступ к файлу не зависит от cookie (авторизация на edge CDN).
STATIC_CACHE_CONTROL=private, no-store

# --- Multipart-загрузка файлов ---
# Лимит на один файл и на весь запрос (формат DataSize: 20MB, 512kB, 1g).
# Запрос чуть больше файла: в multipart прилетают ещё служебные части.
MULTIPART_MAX_FILE_SIZE=20MB
MULTIPART_MAX_REQUEST_SIZE=25MB

# ===========================================================================
# Приложение: профиль и сервер.
# ===========================================================================

# debug — локальная отладка (подробно, с SQL); prod — рабочий контур.
# Профили меняют только уровни логирования (application-*.properties).
SPRING_PROFILES_ACTIVE=debug

SERVER_PORT=8443
KEY_STORE_PATH=file:ssl/keystore.p12
KEY_STORE_TYPE=PKCS12
# Keystore генерируется при старте контейнера (scripts/docker/entrypoint.sh),
# если свой файл не смонтирован в /app/ssl/keystore.p12.
KEY_STORE_ALIAS=tomcat

# ===========================================================================
# База данных: основная PostgreSQL, шарды и прокси.
# ===========================================================================
# Активна одна БД — postgres; шардирование объявлено в профиле `sharding`
# и по умолчанию не поднимается. Имена БД и пользователя ниже общие для
# основной базы, шардов и ShardingSphere-Proxy: при реальном включении
# шардирования правятся здесь, в одном месте.
POSTGRES_USER=user
POSTGRES_DB=desk

# Подключение приложения: по умолчанию — основная БД. Для работы через
# ShardingSphere-Proxy (профиль sharding должен быть запущен) задайте в infrastructure/.env:
#   DB_URL=jdbc:postgresql://shardingsphere:3307/desk
# Правка env-файла и пересборка для этого не нужны.
DB_URL=${DB_URL:-jdbc:postgresql://postgres:5432/desk}
DB_USER=user

# ===========================================================================
# Миграции схемы (Liquibase).
# ===========================================================================
# Структуру создаёт changelog src/main/resources/db/changelog, Hibernate
# в validate только сверяет entity с ней. Изменения структуры — новый
# changeset, не правка руками.
# Префикс DB_MIGRATIONS_, а не LIQUIBASE_: Liquibase 5 сам читает LIQUIBASE_*
# из окружения и warns об этих именах как о «невалидных».
DB_MIGRATIONS_ENABLED=true
DB_MIGRATIONS_CHANGE_LOG=classpath:db/changelog/db.changelog-master.xml

# ===========================================================================
# JPA/Hibernate.
# ===========================================================================
# Режим ddl-auto задан в коде (application.properties, validate) и окружением
# не управляется — так изменяющий схему режим нельзя вернуть ни из env-файлов,
# ни из infrastructure/.env. show-sql/format-sql — отладочный вывод SQL.
JPA_SHOW_SQL=false
JPA_FORMAT_SQL=true

# ===========================================================================
# JWT: домены выдачи (схема — application-domains.properties).
# ===========================================================================
# issuer/audience пишутся в токены и сверяются при валидации. Секрет — в infrastructure/.env,
# сроки жизни и cookie — в секции «Продукт».
JWT_ISSUER=https://example.com
JWT_AUDIENCE=https://example.com
# Origin'ы фронта для CORS, список через запятую (см. cors.allowed-origins).
CORS_ALLOWED_ORIGINS=https://localhost.ru,https://example.com

# ===========================================================================
# Почта: SMTP-сервер окружения (smtp4dev).
# ===========================================================================
# Адреса отправителя и название писем — в секции «Продукт».
MAIL_PROTOCOL=smtp
MAIL_HOST=smtp
MAIL_PORT=25
MAIL_USER=user@example.com
# smtp4dev работает без аутентификации, поэтому пустое значение допустимо.
SMTP_AUTH=false
SMTP_STARTTLS=false

# Домен фронта в письмах (email.domain) — зависит от окружения.
FRONT_DOMAIN=front.example.ru

# ===========================================================================
# Rate limit: доверие к заголовкам прокси.
# ===========================================================================
# Брать клиентский IP из X-Forwarded-For — включать только за прокси.
# Пороги — в секции «Продукт».
TRUST_PROXY_HEADERS=false

# ===========================================================================
# MinIO: хранилище файлов вложений заявок.
# ===========================================================================
# Адрес — имя сервиса compose (внутренняя сеть, не localhost). Учётки совпадают
# с root-ом MinIO и приходят из infrastructure/.env (секреты в infrastructure/docker-compose.yaml), имя
# бакета — в секции «Продукт».
MINIO_ENDPOINT=http://minio:9000

# ===========================================================================
# ShardingSphere-Proxy (профиль `sharding`, по умолчанию не поднимается).
# ===========================================================================
# Порт прокси во внутренней сети; имя БД и пользователь датасource-ов —
# те же, что у основной БД выше. Пароли (SHARD_DB_PASSWORD, пароли прокси) —
# в infrastructure/docker-compose.yaml из infrastructure/.env; валидация обязательных значений — в
# infrastructure/shardingsphere/entrypoint.sh.
PORT=3307
SHARD_DB=desk
SHARD_DB_USER=user

# ===========================================================================
# JVM: диагностика и память (перекрывают ENV образа).
# ===========================================================================
# Диагностика по умолчанию выключена (sec.md §7.8): пустое JAVA_* означает
# «не добавлять флаг», включение — ненулевое значение здесь же (entrypoint
# передаёт его в JVM). Пустое JAVA_XMX переключает entrypoint на
# -XX:MaxRAMPercentage, то есть heap масштабируется вместе с mem_limit
# (45% от 768m ≈ 345M).
JAVA_JFR_OPTS=
JAVA_HEAP_DUMP_OPTS=
JAVA_NMT_OPTS=
JAVA_JMX_OPTS=
JAVA_XMX=
JAVA_RAM_PERCENTAGE=45
