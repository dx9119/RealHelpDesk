# Контекст сборки Docker. Dockerfile копирует только pom.xml, src/, config/
# и scripts/docker/entrypoint.sh, но в контекст daemon'а уходит ВСЯ рабочая
# директория — поэтому здесь явно отсекается то, что не должно покидать
# рабочую станцию.
#
# ВАЖНО: в .dockerignore паттерны без косой черты (как в .gitignore)
# сопоставляются только с корнем контекста. Поэтому для файлов, которые
# могут лежать в любой папке (ключи, `.env`, логи), обязательен префикс `**/`.

# Секреты и ключи — в любом месте дерева
**/.env
**/.env.*
**/*.p12
**/*.key
**/*.pem
**/*.jks
**/ssl/

# Артефакты локальной сборки и VCS
target/
bin/
build/
.gradle/
.idea/
.git/
*.iml

# Документация и скрипты для образа не нужны. `scripts/docker/entrypoint.sh`
# нужен Dockerfile — поэтому scripts/ не исключается целиком, а по частям.
docs/
scripts/e2e-*.sh
scripts/sql/
scripts/docker/stack.env
scripts/docker/check-image.sh
**/*.md
**/*.log
