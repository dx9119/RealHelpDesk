<?xml version="1.0" encoding="UTF-8"?>
<!--
  Ротация refresh-токенов: индекс по created_at для фоновой очистки jwt_tokens
  (RefreshTokenCleanupService удаляет строки старше срока хранения).
-->
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="004-jwt-tokens-created-at-index" author="ukhanov">
        <!-- На базе, где индекс уже есть (например, созданный вручную), changeset помечается выполненным. -->
        <preConditions onFail="MARK_RAN">
            <not>
                <indexExists tableName="jwt_tokens" indexName="idx_jwt_tokens_created_at"/>
            </not>
        </preConditions>
        <!-- Путь от корня classpath, не от этого файла: рядом лежат и changes/, и sql/. -->
        <sqlFile path="db/changelog/sql/004-jwt-tokens-created-at-index.sql"
                 encoding="UTF-8"
                 splitStatements="true"
                 endDelimiter=";"/>
    </changeSet>

</databaseChangeLog>
