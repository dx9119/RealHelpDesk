<?xml version="1.0" encoding="UTF-8"?>
<!--
    Логи тестов: тот же формат, что в logback-spring.xml, но без springProfile.
    logback-spring.xml подхватывает только Spring Boot, поэтому чистые unit-тесты оставались
    на дефолтной конфигурации Logback (root DEBUG в консоль).
-->
<configuration>

    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} | %-5level | %X{requestId:---} | %X{clientIp:---} | %X{uriRequest:---} | %X{role:---} | %X{traceId:---} | %X{spanId:---} | %logger{40} | %msg%n</pattern>
            <charset>UTF-8</charset>
        </encoder>
    </appender>

    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
    </root>

</configuration>
