# Конфигурация Lombok для RealHelpDesk.
# Файл должен лежать в корне проекта (рядом с pom.xml) — Lombok ищет его, поднимаясь по каталогам.

config.stopBubbling = true

# Имя поля логгера — «logger», а не «log»: так заведено в docs/code-style.md,
# и Checkstyle (ConstantName) разрешает именно его.
lombok.log.fieldName = logger

# Помечать сгенерированный код аннотацией @lombok.Generated:
# она исключает сгенерированные геттеры/сеттеры/ equals/hashCode из покрытия JaCoCo
# и из toString/equals там, где это важно (см. @ToString.Exclude ниже по проекту).
lombok.addLombokGeneratedAnnotation = true

# Аннотации, которые Lombok переносит с полей на сгенерированные методы/конструкторы.
# Qualifier — стандартный способ Spring уточнять бин при конструкторной инъекции.
lombok.copyableAnnotations += org.springframework.beans.factory.annotation.Qualifier
