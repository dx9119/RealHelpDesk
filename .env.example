# Шаблон локальных секретов. Рабочий файл .env в git не попадает:
#   cp .env.example .env
#
# Секрет подписи и проверки JWT (HS256, base64, минимум 32 байта).
# Сгенерировать: openssl rand -base64 32
JWT_SECRET=

# Пароль PostgreSQL (общий для приложения и БД).
DB_PASSWORD=

# Пароль от SMTP. smtp4dev по умолчанию работает без аутентификации, поэтому пусто.
MAIL_PASSWORD=

# Пароль keystore. При изменении пересобирайте образ:
#   docker compose build --build-arg KEY_STORE_PASS=<новый пароль>
KEY_STORE_PASS=demo-keystore-pass

# Необязательно: включить капчу на регистрацию (по умолчанию выключена)
# CAPTCHA_ENABLED=true

# Профиль: debug (подробные логи, SQL) или prod (события и ошибки).
# docker compose без этой переменной запускает debug.
# SPRING_PROFILES_ACTIVE=prod
