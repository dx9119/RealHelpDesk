# Шаблон локальных секретов. Рабочий файл .env в git не попадает:
#   cp .env.example .env
#
# Секреты подставляются в docker-compose.yaml: JWT/БД/почта/keystore —
# в services.app.environment, пароли прокси шардирования —
# в services.shardingsphere.environment.
# Все остальные значения конфигурации заданы там же — в application.properties
# значений нет, только обязательные ${VAR}. Пустое значение обязательной
# переменной (JWT_SECRET, DB_PASSWORD, KEY_STORE_PASS) валит compose на старте
# с подсказкой, какого ключа не хватает; пароли ShardingSphere-Proxy нужны,
# только когда включён профиль sharding.

# Секрет подписи и проверки JWT (HS256, base64, минимум 32 байта).
# Сгенерировать: openssl rand -base64 32
JWT_SECRET=

# Пароль PostgreSQL (общий для приложения, основной БД и шардов).
DB_PASSWORD=

# Пароль от SMTP. smtp4dev по умолчанию работает без аутентификации, поэтому пусто.
MAIL_PASSWORD=

# Пароль keystore. Keystore генерируется при старте контейнера,
# поэтому смена пароля не требует пересборки: поправить .env и
#   docker compose up -d
KEY_STORE_PASS=demo-keystore-pass

# Пользователи ShardingSphere-Proxy (шардирование, порт 127.0.0.1:3307):
# root — администрирование, sharding — обычные подключения приложений.
# Шаблон конфигурации: shardingsphere/conf/global.yaml.
# Заполняются перед включением профиля sharding: compose поднимается и с пустыми
# значениями, но прокси без пароля не стартует. Сгенерировать: openssl rand -base64 32
SHARDINGSPHERE_ROOT_PASSWORD=
SHARDINGSPHERE_SHARDING_PASSWORD=

# Режим шардирования. По умолчанию активна одна БД (postgres), сервисы
# shardingsphere/postgres_shard_* лежат в профиле `sharding` и не поднимаются.
# Раскомментировать, чтобы обычный `docker compose up -d` поднимал и шарды:
#COMPOSE_PROFILES=sharding

# Куда подключается приложение. По умолчанию — основная БД; для работы через
# ShardingSphere-Proxy (профиль sharding должен быть запущен):
#DB_URL=jdbc:postgresql://shardingsphere:3307/desk

# Необязательно: имя БД и учётные данные даты-источников прокси.
# По умолчанию — те же, что у основной БД (SHARD_DB=desk, пользователь user,
# пароль равен DB_PASSWORD): менять нужно только при выносе шардов
# на отдельную учётку.
#SHARD_DB=desk
#SHARD_DB_USER=user
#SHARD_DB_PASSWORD=
